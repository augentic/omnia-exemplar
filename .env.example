# Optional
RUST_LOG="info,omnia_wasi_messaging=debug,omnia_wasi_http=debug,guest_typed=debug"

# Deployment environment (prefixes messaging topics, e.g. dev-realtime-pulse.v1)
ENV="dev"

# Upstream operator APIs
BLOCK_MGT_URL="https://block-mgt.api.acme.example"
STATIC_API_URL="https://static.api.acme.example"
FLEET_URL="https://fleet.api.acme.example"
TRIP_MANAGEMENT_URL="https://trip-mgt.api.acme.example"

# Identity used to acquire access tokens for the operator APIs
API_IDENTITY="<identity name>"
IDENTITY_CLIENT_ID="<client_id>"
IDENTITY_CLIENT_SECRET="<client_secret>"
IDENTITY_TOKEN_URL="<token endpoint>"

# Optional: enable god-mode trip overrides (also requires building with --features god-mode)
# GOD_MODE_ENABLED="false"

# Pattern-example routes (/examples/patterns/*)
PATTERN_DECODER_URL="https://decoder.api.acme.example/decode"
PATTERN_CLIENT_CERT="<base64 client certificate>"
